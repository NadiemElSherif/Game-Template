              "image": "hero_determined",
              "position": "left"
            }
          ],
          "text": "You take a deep breath and step forward. The sounds of the outside world fade behind you as you enter the realm of shadow and light.",
          "nextAction": {
            "type": "update",
            "nextPageId": "ch1_3"
          }
        },
