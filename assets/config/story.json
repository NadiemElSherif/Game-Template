          "pageId": "ch1_3",
          "backgroundTop": "light_rays",
          "audio": {
            "bgm": "mysterious_encounter",
            "volume": 0.6,
            "fadeTime": 3000
          },
          "characters": [
            {
              "image": "hero_surprised",
              "position": "left"
            }
          ],
          "text": "Suddenly, a beam of light breaks through the canopy, illuminating a strange marking on a nearby tree. It seems to **glow** with an inner light.",
          "nextAction": {
            "type": "update",
            "nextPageId": "ch1_4"
          }
        },
        {
          "pageId": "ch1_4",
          "backgroundTop": "light_rays",
          "characters": [
            {
              "image": "hero_curious",
              "position": "left"
            }
          ],
          "text": "As you approach the marking, you hear a rustling in the bushes to your right.",
          "nextAction": {
            "type": "update",
            "nextPageId": "ch1_5"
          }
        },
        {
          "pageId": "ch1_5",
          "backgroundTop": "light_rays",
          "characters": [
            {
              "image": "hero_alert",
              "position": "left"
            },
            {
              "image": "guide_hidden",
              "position": "right"
            }
          ],
          "text": "You freeze, hand moving instinctively to your pack. Something—or someone—is watching you.",
          "nextAction": {
            "type": "update",
            "nextPageId": "ch1_6"
          }
        },
        {
          "pageId": "ch1_6",
          "backgroundTop": null,
          "characters": [
            {
              "image": "hero_surprised",
              "position": "left"
            },
            {
              "image": "guide_reveal",
              "position": "right"
            }
          ],
          "audio": {
            "bgm": "guide_theme",
            "volume": 0.5,
            "fadeTime": 1500
          },
          "text": "A figure emerges from the foliage—not a beast, but a person wrapped in a green cloak, face partially hidden beneath a hood.",
          "nextAction": {
            "type": "update",
            "nextPageId": "ch1_7"
          }
        },
        {
          "pageId": "ch1_7",
          "backgroundTop": null,
          "characters": [
            {
              "image": "hero_cautious",
              "position": "left"
            },
            {
              "image": "guide_smile",
              "position": "right"
            }
          ],
          "text": "\"**Well met, traveler,**\" the stranger says with a gentle smile. \"Few venture this far into the Whispering Woods. Might I ask what brings you here?\"",
          "nextAction": {
            "type": "transition",
            "targetScene": "forest_info"
          }
        }
      ]
    },
