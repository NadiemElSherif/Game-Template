{
  "gameSettings": {
    "width": 800,
    "height": 600,
    "defaultFont": "Arial",
    "defaultFontSize": 18,
    "defaultTextColor": "#ffffff",
    "initialScene": "mainMenu",
    "defaultAudio": {
      "bgm": "main_theme",
      "volume": 0.7,
      "fadeTime": 1000
    },
    "bootScene": {
      "background": "loading-bg"
    }
  },
  "characters": {
    "positions": {
      "left": 200,
      "right": 600
    },
    "yOffset": 50,
    "maxHeight": 350
  },
  "scenes": {
    "mainMenu": {
      "type": "MainMenuScene",
      "background": "menu_bg",
      "audio": {
        "bgm": "main_theme",
        "volume": 0.6
      },
      "button": {
        "x": 400,
        "y": 350,
        "image": "start_button",
        "text": "Start Story",
        "sfx": "button_click",
        "nextScene": "intro"
      },
      "title": {
        "text": "My Simple Story",
        "x": 400,
        "y": 200,
        "fontSize": 48,
        "fontFamily": "Arial",
        "color": "#ffffff"
      }
    },
    "intro": {
      "type": "InfoScene",
      "background": "intro_bg",
      "audio": {
        "bgm": "intro_theme",
        "volume": 0.5
      },
      "textArea": {
        "x": 100,
        "y": 150,
        "width": 600,
        "height": 300,
        "padding": 20,
        "backgroundColor": "rgba(0, 0, 0, 0.7)",
        "content": [
          "Welcome to my simple visual novel example.\n\nThis is a basic story to test the Phaser 3 Visual Storytelling Engine.",
          "Let's meet our characters and begin our adventure!"
        ]
      },
      "button": {
        "x": 650,
        "y": 500,
        "image": "next_button",
        "text": "Next",
        "sfx": "button_click",
        "nextScene": "conversation"
      }
    },
    "conversation": {
      "type": "DialogueScene",
      "globalBackground": "room_bg",
      "audio": {
        "bgm": "conversation_theme",
        "volume": 0.4
      },
      "textBox": {
        "background": "textbox_bg",
        "x": 50,
        "y": 400,
        "width": 700,
        "height": 150,
        "padding": 20
      },
      "button": {
        "x": 700,
        "y": 530,
        "image": "next_arrow",
        "sfx": "page_turn"
      },
      "pages": [
        {
          "pageId": "page1",
          "backgroundTop": null,
          "characters": [
            {
              "image": "character_a",
              "position": "left"
            }
          ],
          "text": "Hello there! My name is Alex. I'm one of the characters in this simple story.",
          "nextAction": {
            "type": "update",
            "nextPageId": "page2"
          }
        },
        {
          "pageId": "page2",
          "backgroundTop": null,
          "characters": [
            {
              "image": "character_a",
              "position": "left"
            },
            {
              "image": "character_b",
              "position": "right"
            }
          ],
          "text": "And I'm Taylor! Nice to meet you!",
          "nextAction": {
            "type": "update",
            "nextPageId": "page3"
          }
        },
        {
          "pageId": "page3",
          "backgroundTop": null,
          "characters": [
            {
              "image": "character_a_smile",
              "position": "left"
            },
            {
              "image": "character_b",
              "position": "right"
            }
          ],
          "text": "Together, we're going to show you how this visual novel engine works.",
          "nextAction": {
            "type": "update",
            "nextPageId": "page4"
          }
        },
        {
          "pageId": "page4",
          "backgroundTop": null,
          "audio": {
            "bgm": "exciting_theme",
            "volume": 0.5,
            "fadeTime": 1000
          },
          "characters": [
            {
              "image": "character_a_excited",
              "position": "left"
            },
            {
              "image": "character_b_excited",
              "position": "right"
            }
          ],
          "text": "This is an example of changing music during a scene! We can also use **bold text** for emphasis!",
          "nextAction": {
            "type": "transition",
            "targetScene": "end"
          }
        }
      ]
    },
    "end": {
      "type": "InfoScene",
      "background": "end_bg",
      "audio": {
        "bgm": "ending_theme",
        "volume": 0.6
      },
      "textArea": {
        "x": 100,
        "y": 150,
        "width": 600,
        "height": 300,
        "padding": 20,
        "backgroundColor": "rgba(0, 0, 0, 0.7)",
        "content": [
          "That's the end of our simple demo!\n\nYou've seen how scenes transition, characters appear, and text displays."
        ]
      },
      "button": {
        "x": 650,
        "y": 500,
        "image": "next_button",
        "text": "Credits",
        "sfx": "button_click",
        "nextScene": "credits"
      }
    },
    "credits": {
      "type": "CreditsScene",
      "background": "credits_bg",
      "audio": {
        "bgm": "credits_theme",
        "volume": 0.5,
        "fadeTime": 2000
      },
      "content": "Simple Visual Novel\n\nCreated with\nPhaser 3 Visual Storytelling Engine\n\nThank you for playing!",
      "scrollSpeed": 20.0,
      "textStyle": {
        "fontFamily": "Arial",
        "fontSize": 24,
        "color": "#ffffff",
        "align": "center"
      },
      "exitBehavior": {
        "action": "transition",
        "targetScene": "mainMenu",
        "delay": 2000
      }
    }
  },
  "assets": {
    "backgrounds": [
      { "key": "menu_bg", "path": "assets/images/backgrounds/menu_bg.png" },
      { "key": "intro_bg", "path": "assets/images/backgrounds/intro_bg.png" },
      { "key": "room_bg", "path": "assets/images/backgrounds/room_bg.png" },
      { "key": "end_bg", "path": "assets/images/backgrounds/end_bg.png" },
      {
        "key": "credits_bg",
        "path": "assets/images/backgrounds/credits_bg.png"
      }
    ],
    "characters": [
      {
        "key": "character_a",
        "path": "assets/images/characters/character_a.png"
      },
      {
        "key": "character_a_smile",
        "path": "assets/images/characters/character_a_smile.png"
      },
      {
        "key": "character_a_excited",
        "path": "assets/images/characters/character_a_excited.png"
      },
      {
        "key": "character_b",
        "path": "assets/images/characters/character_b.png"
      },
      {
        "key": "character_b_excited",
        "path": "assets/images/characters/character_b_excited.png"
      }
    ],
    "ui": [
      { "key": "start_button", "path": "assets/images/ui/start_button.png" },
      { "key": "next_button", "path": "assets/images/ui/next_button.png" },
      { "key": "next_arrow", "path": "assets/images/ui/next_arrow.png" },
      { "key": "textbox_bg", "path": "assets/images/ui/textbox_bg.png" },
      { "key": "loading-bg", "path": "assets/images/ui/loading-bg.png" },
      { "key": "loading-bar-bg", "path": "assets/images/ui/loading-bar-bg.png" }
    ],
    "audio": {
      "bgm": [
        {
          "key": "main_theme",
          "path": "assets/audio/music/main_theme.mp3",
          "loop": true
        },
        {
          "key": "intro_theme",
          "path": "assets/audio/music/intro_theme.mp3",
          "loop": true
        },
        {
          "key": "conversation_theme",
          "path": "assets/audio/music/conversation_theme.mp3",
          "loop": true
        },
        {
          "key": "exciting_theme",
          "path": "assets/audio/music/exciting_theme.mp3",
          "loop": true
        },
        {
          "key": "ending_theme",
          "path": "assets/audio/music/ending_theme.mp3",
          "loop": true
        },
        {
          "key": "credits_theme",
          "path": "assets/audio/music/credits_theme.mp3",
          "loop": true
        }
      ],
      "sfx": [
        { "key": "button_click", "path": "assets/audio/sfx/button_click.mp3" },
        { "key": "page_turn", "path": "assets/audio/sfx/page_turn.mp3" }
      ]
    }
  }
}
